<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The hardened runtime only loads libraries signed by the app's own team. The libgphoto2
	  libraries in Contents/Frameworks/gphoto are signed ad hoc, and the LGPL lets anyone replace
	  them with their own build (docs/third-party-notices.md), so the app must load them anyway.
	  Checked by `bundle-libgphoto2.sh verify`.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
