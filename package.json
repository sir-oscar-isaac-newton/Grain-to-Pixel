{
  "name": "grain-to-pixel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @gtp/desktop dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:rust": "cargo test --workspace",
    "test:tools": "node --test tools/scripts/check-deps/check-deps.test.mjs tools/scripts/check-ipc/check-ipc.test.mjs tools/scripts/smoke/smoke.test.mjs",
    "build:app": "pnpm --filter @gtp/desktop exec tauri build --no-bundle",
    "smoke": "node tools/scripts/smoke/smoke.mjs --binary target/release/grain-to-pixel-desktop",
    "test:e2e": "node --test apps/desktop/tests/e2e/window.e2e.mjs",
    "gen:ipc": "cargo run -q -p grain-to-pixel-desktop --example gen_ipc -- packages/ipc-types/src/bindings.ts",
    "check:ipc": "node tools/scripts/check-ipc/check-ipc.mjs",
    "check:deps": "node tools/scripts/check-deps/check-deps.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
